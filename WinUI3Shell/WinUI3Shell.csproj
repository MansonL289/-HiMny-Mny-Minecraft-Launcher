<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MnyMinecraftLauncher</AssemblyName>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinUI3Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Head.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- dotnet publish 不会自动带上 XAML 编译产物（.xbf / .pri），这里手动补齐，否则发布版启动即崩溃 -->
  <Target Name="CopyXamlArtifactsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XamlArtifacts Include="$(OutDir)**\*.xbf" Exclude="$(PublishDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlArtifacts)" DestinationFolder="$(PublishDir)%(_XamlArtifacts.RecursiveDir)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFiles="$(PublishDir)$(AssemblyName).pri" />
  </Target>

</Project>
