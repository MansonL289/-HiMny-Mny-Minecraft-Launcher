<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 嵌入式标题栏：整条区域都可拖动窗口，标题栏按钮由系统绘制在右侧 -->
        <Grid x:Name="AppTitleBar" Background="Transparent" ColumnDefinitions="*,Auto">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Padding="16,0,0,0"
                Spacing="12">
                <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                <TextBlock
                    Text="MnyLauncher"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
            <!-- 全局下载快捷入口：右上角（在系统窗口按钮左侧），有后台任务时显示 -->
            <Button
                x:Name="DlIndicator"
                Grid.Column="1"
                Padding="10,4"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                AutomationProperties.Name="下载任务"
                Click="DlIndicator_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Download" />
                    <TextBlock
                        x:Name="DlCountText"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="0" />
                </StackPanel>
            </Button>
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            PaneDisplayMode="Left"
            OpenPaneLength="213"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="启动" Tag="Launch.Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载" Tag="Download.Vanilla">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 底部固定区：账号、MOD 库、设置 -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="账号" Tag="Account">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="库" Tag="Mod.Library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame">
                <!-- 页面实例手动缓存不走 Navigate，这里用 ContentTransitions 补回切换动画 -->
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- 下载完成提示：顶部横幅，「查看」去库，「安装」直接选版本安装（MOD/安装器才有） -->
        <Border
            x:Name="DoneBanner"
            Grid.Row="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"
            Padding="16,9"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            Visibility="Collapsed"
            Opacity="0"
            PointerEntered="DoneBanner_PointerEntered"
            PointerExited="DoneBanner_PointerExited">
            <!-- 80% 透明的毛玻璃：只给背景加亚克力，文字保持完全不透明，保证清晰 -->
            <Border.Background>
                <AcrylicBrush
                    TintColor="{ThemeResource SystemChromeAltHighColor}"
                    TintOpacity="0.2"
                    TintLuminosityOpacity="0.9"
                    FallbackColor="{ThemeResource SystemChromeMediumLowColor}" />
            </Border.Background>
            <Border.RenderTransform>
                <TranslateTransform x:Name="DoneBannerTransform" Y="-16" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon
                    Glyph="&#xE73E;"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="DoneBannerText"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Content="查看"
                    Padding="12,4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Click="DoneBannerView_Click" />
                <Button
                    x:Name="DoneBannerInstallButton"
                    Content="安装"
                    Padding="12,4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed"
                    Click="DoneBannerInstall_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
