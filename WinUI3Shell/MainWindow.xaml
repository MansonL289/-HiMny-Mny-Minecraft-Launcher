<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 嵌入式标题栏：整条区域都可拖动窗口，标题栏按钮由系统绘制在右侧 -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Padding="16,0,0,0"
                Spacing="12">
                <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                <TextBlock
                    Text="MnyLauncher"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <!-- 全局下载指示：有后台下载任务时显示，点击跳到下载页 -->
                <Button
                    x:Name="DlIndicator"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="DlIndicator_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Download" />
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="True"
                            IsIndeterminate="True" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            PaneDisplayMode="Left"
            OpenPaneLength="213"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="启动" Tag="Launch.Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载" Tag="Download.Vanilla">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 底部固定区：账号、MOD 库、设置 -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="账号" Tag="Account">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="库" Tag="Mod.Library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame">
                <!-- 页面实例手动缓存不走 Navigate，这里用 ContentTransitions 补回切换动画 -->
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- 下载完成提示：顶部横幅，点击跳转到「库」 -->
        <Border
            x:Name="DoneBanner"
            Grid.Row="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"
            Padding="16,10"
            CornerRadius="8"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            Visibility="Collapsed"
            PointerEntered="DoneBanner_PointerEntered"
            PointerExited="DoneBanner_PointerExited">
            <Button
                x:Name="DoneBannerButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Click="DoneBanner_Click"
                HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Accept" Foreground="White" />
                    <TextBlock
                        x:Name="DoneBannerText"
                        Foreground="White"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="White"
                        Opacity="0.7"
                        VerticalAlignment="Center"
                        Text="前往库" />
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</Window>
