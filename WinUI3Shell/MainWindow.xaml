<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 嵌入式标题栏：整条区域都可拖动窗口，标题栏按钮由系统绘制在右侧 -->
        <Grid x:Name="AppTitleBar" Background="Transparent" ColumnDefinitions="*,Auto">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Padding="16,0,0,0"
                Spacing="12">
                <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                <TextBlock
                    Text="MnyLauncher"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- 全局下载指示：只在有后台下载任务时显示一个下载图标，切换带淡入缩放动画 -->
            <Button
                x:Name="DlIndicator"
                Grid.Column="1"
                Margin="0,0,150,0"
                Padding="6"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Opacity="0"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5"
                Click="DlIndicator_Click">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="DlIndicatorScale" />
                </Button.RenderTransform>
                <SymbolIcon Symbol="Download" />
            </Button>
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            PaneDisplayMode="Left"
            OpenPaneLength="213"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="启动" Tag="Launch.Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载" Tag="Download.Vanilla">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 底部固定区：账号、MOD 库、设置 -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="账号" Tag="Account">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="库" Tag="Mod.Library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame">
                <!-- 页面实例手动缓存不走 Navigate，这里用 ContentTransitions 补回切换动画 -->
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- 下载完成提示：WinUI 卡片风格，出现/消失带淡入上浮动画 -->
        <Border
            x:Name="DoneBanner"
            Grid.Row="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"
            Padding="14,10"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed"
            Opacity="0"
            RenderTransformOrigin="0.5,0"
            PointerEntered="DoneBanner_PointerEntered"
            PointerExited="DoneBanner_PointerExited">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DoneBannerTransform" />
            </Border.RenderTransform>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="14">
                    <Grid>
                        <FontIcon
                            x:Name="DoneBannerIconOk"
                            Glyph="&#xE73E;"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <FontIcon
                            x:Name="DoneBannerIconBad"
                            Glyph="&#xE711;"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
                <TextBlock
                    x:Name="DoneBannerText"
                    Grid.Column="1"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="DoneBannerView_Click"
                    Content="查看" />
                <Button
                    x:Name="DoneBannerInstallButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="DoneBannerInstall_Click"
                    Content="安装"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
