<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 嵌入式标题栏：整条区域都可拖动窗口，标题栏按钮由系统绘制在右侧 -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Padding="16,0,0,0"
                Spacing="12">
                <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                <TextBlock
                    Text="MnyLauncher"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <!-- 全局下载指示：有后台下载任务时显示，点击跳到下载页 -->
                <Button
                    x:Name="DlIndicator"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="DlIndicator_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Download" />
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="True"
                            IsIndeterminate="True" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            PaneDisplayMode="Left"
            OpenPaneLength="213"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="启动" Tag="Launch.Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载" Tag="Download.Vanilla">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 底部固定区：MOD 库、设置 -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="MOD库" Tag="Mod.Library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame">
                <!-- 页面实例手动缓存不走 Navigate，这里用 ContentTransitions 补回切换动画 -->
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
