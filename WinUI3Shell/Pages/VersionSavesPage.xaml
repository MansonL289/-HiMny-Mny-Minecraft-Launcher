<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.VersionSavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20,20,20,12" RowDefinitions="Auto,*,Auto">
        <!-- 工具栏 -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="ImportSave_Click" Content="导入存档" />
            <Button Click="OpenSavesDir_Click" Content="打开存档文件夹" />
            <Button Click="OpenBackupsDir_Click" Content="本地备份" />
            <Button
                AutomationProperties.Name="刷新列表"
                ToolTipService.ToolTip="刷新列表"
                Click="Refresh_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </StackPanel>

        <!-- 存档列表 + 空状态提示 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ListView
                x:Name="SaveList"
                ItemsSource="{x:Bind Saves}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SubtitleText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{Binding FolderName}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                                <Button
                                    Click="ViewSave_Click"
                                    Content="查看"
                                    Tag="{Binding}" />
                                <Button
                                    Click="EditSave_Click"
                                    Content="修改"
                                    Tag="{Binding}" />
                                <Button
                                    Click="MoreSave_Click"
                                    Content="更多"
                                    Tag="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE8B7;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="还没有存档" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Text="进入游戏创建世界后，存档会出现在这里" />
            </StackPanel>
        </Grid>

        <!-- 底部：统计 + 状态 -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
