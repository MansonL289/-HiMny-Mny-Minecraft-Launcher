<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.DownloadSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24">
        <StackPanel Spacing="8">
            <TextBlock Text="下载源" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox
                x:Name="MirrorBox"
                Width="240"
                HorizontalAlignment="Left"
                SelectionChanged="MirrorBox_SelectionChanged">
                <ComboBoxItem Content="断点换源" Tag="auto" />
                <ComboBoxItem Content="BMCLAPI 镜像" Tag="bmclapi" />
                <ComboBoxItem Content="官方源" Tag="official" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="下载限速" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox
                x:Name="LimitBox"
                Width="240"
                HorizontalAlignment="Left"
                SelectionChanged="LimitBox_SelectionChanged">
                <ComboBoxItem Content="不限速" Tag="0" />
                <ComboBoxItem Content="1 MB/s" Tag="1024" />
                <ComboBoxItem Content="2 MB/s" Tag="2048" />
                <ComboBoxItem Content="5 MB/s" Tag="5120" />
                <ComboBoxItem Content="10 MB/s" Tag="10240" />
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock Text="CurseForge" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <PasswordBox
                x:Name="CfKeyBox"
                Width="420"
                HorizontalAlignment="Left"
                Header="API Key"
                PlaceholderText="未填写则无法安装 CurseForge 整合包"
                LostFocus="CfKeyBox_LostFocus" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Key 在 console.curseforge.com 免费申请，只保存在本机。"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
