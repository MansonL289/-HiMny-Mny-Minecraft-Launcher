<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.DownloadSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="24">
        <StackPanel Spacing="8">
            <TextBlock Text="下载源" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox
                x:Name="MirrorBox"
                Width="200"
                HorizontalAlignment="Left"
                SelectionChanged="MirrorBox_SelectionChanged">
                <ComboBoxItem Content="BMCLAPI 镜像" Tag="bmclapi" />
                <ComboBoxItem Content="官方源" Tag="official" />
            </ComboBox>
            <TextBlock
                Text="国内网络建议选择 BMCLAPI 镜像；下载页与启动时的自动补全下载都使用此源。"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</Page>
