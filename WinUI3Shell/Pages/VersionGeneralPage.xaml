<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.VersionGeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="560" Padding="20,20,20,24" Spacing="12">
            <!-- 版本 -->
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="版本" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="NameBox"
                    Width="240"
                    Header="名字" />
                <Button
                    VerticalAlignment="Bottom"
                    Click="Rename_Click"
                    Content="保存名字" />
            </StackPanel>
            <ToggleSwitch
                x:Name="PinToggle"
                Header="置顶（版本选择时排在最前）"
                Toggled="PinToggle_Toggled" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Button Click="ChangeIcon_Click" Content="更改图标" />
                <Button Click="ClearIcon_Click" Content="清除图标" />
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <!-- 快捷方式 -->
            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="快捷方式" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Button Click="OpenVersionDir_Click" Content="版本文件夹" />
                <Button Click="OpenSavesDir_Click" Content="存档文件夹" />
                <Button x:Name="ModsDirButton" Click="OpenModsDir_Click" Content="Mod 文件夹" />
                <Button Click="OpenScreenshotsDir_Click" Content="截图文件夹" />
            </StackPanel>

            <!-- 高级 -->
            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="高级" />
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                    <Button x:Name="ExportScriptButton" Click="ExportScript_Click" Content="导出启动脚本" />
                    <Button x:Name="ExportPackButton" Click="ExportPack_Click" Content="导出整合包" />
                    <Button Click="Delete_Click" Content="删除版本" Foreground="#FF6363" />
                </StackPanel>
                <ProgressRing
                    x:Name="ExportRing"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
