<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.ModpackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,12" RowDefinitions="Auto,*,Auto">
        <!-- 顶部：选择本地整合包文件 -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PickButton" Click="Pick_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    <TextBlock Text="选择整合包" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <!-- 整合包预览 + 安装名 -->
            <StackPanel
                x:Name="InfoPanel"
                MaxWidth="560"
                HorizontalAlignment="Left"
                Spacing="16"
                Visibility="Collapsed">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="PackName"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PackMeta"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="安装名" />
                    <TextBox x:Name="InstallNameBox" PlaceholderText="用作启动列表里的版本名" />
                    <Button
                        x:Name="InstallButton"
                        Click="Install_Click"
                        Content="安装整合包"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- 空状态 -->
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE7B8;"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="EmptyText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="选择一个 .mrpack 或 CurseForge .zip 整合包开始安装" />
            </StackPanel>

            <!-- 加载动画：容器正中 -->
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
