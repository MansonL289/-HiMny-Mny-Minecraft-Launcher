<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.SaveBasicEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="4,0,8,0" Spacing="14">
            <TextBlock
                x:Name="SaveNameText"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextWrapping="Wrap" />

            <ComboBox
                x:Name="ModeCombo"
                Width="220"
                Header="游戏模式"
                HorizontalAlignment="Left"
                SelectionChanged="Mode_Changed">
                <ComboBoxItem Content="生存" Tag="0" />
                <ComboBoxItem Content="创造" Tag="1" />
                <ComboBoxItem Content="冒险" Tag="2" />
                <ComboBoxItem Content="旁观" Tag="3" />
            </ComboBox>

            <ToggleSwitch
                x:Name="CheatsToggle"
                Header="允许作弊指令"
                Toggled="Cheats_Toggled" />

            <!-- 游戏规则入口：具体规则在子页面里调 -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="游戏规则" />
                <TextBlock
                    x:Name="RulesText"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Left"
                    Click="EditRules_Click"
                    Content="调整游戏规则..." />
            </StackPanel>

            <TextBlock
                x:Name="HintText"
                FontSize="12"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
