<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.ModSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid Padding="24,20,24,12" RowDefinitions="Auto,*,Auto">
        <!-- 搜索 + 加载器筛选 -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox
                x:Name="QueryBox"
                MinWidth="160"
                KeyDown="QueryBox_KeyDown"
                PlaceholderText="搜索 Mod" />
            <ComboBox
                x:Name="LoaderFilter"
                Grid.Column="1"
                MinWidth="112"
                SelectedIndex="0"
                SelectionChanged="LoaderFilter_SelectionChanged">
                <ComboBoxItem Content="全部加载器" Tag="" />
                <ComboBoxItem Content="Fabric" Tag="fabric" />
                <ComboBoxItem Content="Forge" Tag="forge" />
                <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                <ComboBoxItem Content="Quilt" Tag="quilt" />
            </ComboBox>
            <Button
                x:Name="SearchButton"
                Grid.Column="2"
                Click="Search_Click"
                Content="搜索"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- 结果列表：点击进入 Mod 详情 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ListView
                x:Name="ResultList"
                IsItemClickEnabled="True"
                ItemClick="ResultList_ItemClick"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <!-- Mod 图标 -->
                            <Grid Width="48" Height="48" VerticalAlignment="Top">
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" />
                                <FontIcon
                                    Glyph="&#xE7B8;"
                                    FontSize="20"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding AuthorText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    MaxLines="3"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding MetaText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE721;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="EmptyText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="没有找到匹配的 Mod" />
            </StackPanel>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
