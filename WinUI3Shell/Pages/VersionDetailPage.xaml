<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.VersionDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="24" MaxWidth="560">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.Name="返回"
                ToolTipService.ToolTip="返回"
                Click="Back_Click">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="12">
            <TextBlock Text="附加模块" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButtons
                x:Name="LoaderRadio"
                SelectedIndex="0"
                SelectionChanged="LoaderRadio_SelectionChanged">
                <RadioButton Content="不安装（原版）" />
                <RadioButton x:Name="FabricRadio" Content="Fabric（自动安装）" />
                <RadioButton x:Name="ForgeRadio" Content="Forge（自动安装）" />
                <RadioButton x:Name="NeoForgeRadio" Content="NeoForge（自动安装）" />
            </RadioButtons>

            <!-- 选择加载器后可手动挑版本，默认自动选最新 -->
            <ComboBox
                x:Name="LoaderVersionCombo"
                Width="320"
                HorizontalAlignment="Left"
                Header="加载器版本"
                Visibility="Collapsed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
                x:Name="LoaderVersionStatus"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <TextBox
                x:Name="VersionNameBox"
                Header="版本名"
                MaxLength="64" />
        </StackPanel>

        <Button
            Content="开始下载"
            HorizontalAlignment="Left"
            Style="{StaticResource AccentButtonStyle}"
            Click="Start_Click" />
        <TextBlock
            x:Name="StatusText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
