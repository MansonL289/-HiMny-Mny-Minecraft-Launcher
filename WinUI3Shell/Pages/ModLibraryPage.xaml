<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.ModLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,16" RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                Text="MOD 库"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="Refresh_Click"
                Content="刷新" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ListView x:Name="ModList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <!-- Mod 图标 -->
                            <Grid Width="44" Height="44" VerticalAlignment="Center">
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" />
                                <FontIcon
                                    Glyph="&#xE7B8;"
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{Binding DetailText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="Install_Click"
                                Content="安装到版本"
                                Tag="{Binding}" />
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Click="Delete_Click"
                                Content="删除"
                                Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE7B8;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="还没有下载的 Mod，去「下载 - MOD」里挑一个" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="8">
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <ProgressBar
                x:Name="InstallBar"
                Maximum="1"
                Visibility="Collapsed" />
            <Button
                x:Name="CancelButton"
                HorizontalAlignment="Left"
                Click="Cancel_Click"
                Content="取消"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
