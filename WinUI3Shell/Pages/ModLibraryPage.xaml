<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.ModLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <DataTemplate x:Key="VersionItemTemplate">
            <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Grid Width="44" Height="44" VerticalAlignment="Center">
                    <Image
                        Source="{Binding IconUrl}"
                        Width="36"
                        Height="36"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Loader}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OpenVersionFolder_Click"
                    Content="打开文件夹"
                    Tag="{Binding Name}" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="DeleteVersion_Click"
                    Content="删除"
                    Tag="{Binding Name}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ModItemTemplate">
            <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Grid Width="44" Height="44" VerticalAlignment="Center">
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" />
                    <FontIcon
                        Glyph="&#xE7B8;"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Text="{Binding DetailText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="Install_Click"
                    Content="安装到版本"
                    Tag="{Binding}" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="Delete_Click"
                    Content="删除"
                    Tag="{Binding}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="InstallerItemTemplate">
            <Grid Padding="0,6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Image
                    Width="32"
                    Height="32"
                    Source="{Binding IconUrl}"
                    Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding DetailText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="InstallInstaller_Click"
                    Content="安装到版本"
                    Tag="{Binding}" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="DeleteInstaller_Click"
                    Content="删除"
                    Tag="{Binding}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ServerItemTemplate">
            <Grid Padding="0,6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <FontIcon
                    Glyph="&#xE7B8;"
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding DetailText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OpenServerFolder_Click"
                    Content="打开文件夹"
                    Tag="{Binding}" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="DeleteServer_Click"
                    Content="删除"
                    Tag="{Binding}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,12,24,16" ColumnDefinitions="180,*">
        <!-- 左侧栏目：版本 / MOD / 安装器（含子栏目） -->
        <NavigationView
            x:Name="SideBar"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="180"
            PaneDisplayMode="Left"
            SelectionChanged="SideBar_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="版本" Tag="versions" IsSelected="True" />
                <NavigationViewItem Content="MOD" Tag="mods" />
                <NavigationViewItem Content="安装器" Tag="loaders" IsExpanded="True">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Forge" Tag="forge" />
                        <NavigationViewItem Content="Fabric" Tag="fabric" />
                        <NavigationViewItem Content="NeoForge" Tag="neoforge" />
                        <NavigationViewItem Content="Quilt" Tag="quilt" />
                        <NavigationViewItem Content="OptiFine" Tag="optifine" />
                        <NavigationViewItem Content="LiteLoader" Tag="liteloader" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="服务端" Tag="servers" />
            </NavigationView.MenuItems>
        </NavigationView>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1" Margin="16,0,0,0" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    x:Name="TitleText"
                    Text="版本"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="Refresh_Click"
                    Content="刷新" />
            </Grid>

            <!-- 版本列表：原版一栏，各加载器各一栏 -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid x:Name="VersionsPanel" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="VersionGroups" Spacing="6" />
                    </ScrollViewer>
                    <TextBlock
                        x:Name="VersionEmpty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="还没有安装的版本，去「下载」里装一个"
                        Visibility="Collapsed" />
                </Grid>

                <!-- MOD 列表 -->
                <Grid x:Name="ModsPanel" Visibility="Collapsed">
                    <ListView
                        x:Name="ModList"
                        SelectionMode="None"
                        ItemTemplate="{StaticResource ModItemTemplate}" />
                    <StackPanel
                        x:Name="EmptyHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            Glyph="&#xE7B8;"
                            FontSize="36"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            Text="还没有下载的 Mod，去「下载 - MOD」里挑一个" />
                    </StackPanel>
                </Grid>

                <!-- 安装器列表：已安装（已装出对应版本）/ 未安装（还没装过）两栏 -->
                <Grid x:Name="LoaderPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LoaderGroups" Spacing="6" />
                    </ScrollViewer>
                    <TextBlock
                        x:Name="LoaderEmpty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="还没有下载的安装器，去「下载」里挑一个"
                        Visibility="Collapsed" />
                </Grid>

                <!-- 服务端：已下载的服务端 jar -->
                <Grid x:Name="ServerPanel" Visibility="Collapsed">
                    <ListView
                        x:Name="ServerList"
                        SelectionMode="None"
                        ItemTemplate="{StaticResource ServerItemTemplate}" />
                    <TextBlock
                        x:Name="ServerEmpty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="还没有下载的服务端，去「下载 - 服务端」里挑一个"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
