<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="SettingsPage_Loaded">

    <Grid Padding="32" RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="返回"
                ToolTipService.ToolTip="返回"
                Visibility="Collapsed"
                Click="BackButton_Click">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock
                x:Name="HeaderText"
                Text="设置"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
        </StackPanel>
        <Frame
            x:Name="SettingsFrame"
            Grid.Row="1"
            Navigated="SettingsFrame_Navigated" />
    </Grid>
</Page>
