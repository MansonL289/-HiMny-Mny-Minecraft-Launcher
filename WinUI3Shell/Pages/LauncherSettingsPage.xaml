<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.LauncherSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="24">
        <StackPanel Spacing="8">
            <TextBlock Text="应用主题" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButtons
                x:Name="ThemeRadioButtons"
                SelectionChanged="ThemeRadioButtons_SelectionChanged">
                <RadioButton Content="浅色" />
                <RadioButton Content="深色" />
                <RadioButton Content="使用系统设置" />
            </RadioButtons>
        </StackPanel>

        <ToggleSwitch
            x:Name="StartupToggle"
            Header="开机自启动"
            OnContent="已开启"
            OffContent="已关闭"
            Toggled="StartupToggle_Toggled" />

        <StackPanel Spacing="8">
            <TextBlock Text="游戏文件" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button
                Content="打开版本文件夹"
                HorizontalAlignment="Left"
                Click="OpenVersionsFolder_Click" />
        </StackPanel>
    </StackPanel>
</Page>
