<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.ServerDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部：版本分类 + 刷新 -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox
                x:Name="CategoryBox"
                Width="130"
                Height="32"
                SelectedIndex="0"
                SelectionChanged="CategoryBox_SelectionChanged">
                <ComboBoxItem Content="正式版" Tag="release" />
                <ComboBoxItem Content="快照版" Tag="snapshot" />
            </ComboBox>
            <Button
                x:Name="RefreshButton"
                Height="32"
                AutomationProperties.Name="刷新版本列表"
                ToolTipService.ToolTip="刷新版本列表"
                Click="Refresh_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </StackPanel>

        <!-- 版本列表 + 加载动画 -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <ListView x:Name="VersionList" SelectionChanged="VersionList_SelectionChanged" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>

        <!-- 底部：下载进度 + 操作 -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <ProgressBar x:Name="DlProgress" Visibility="Collapsed" />
            <StackPanel
                Grid.Row="1"
                Margin="0,12,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="DownloadButton"
                    Content="下载服务端 .jar"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Download_Click" />
                <Button Content="打开服务端文件夹" Click="OpenServerDir_Click" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
