<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.OptiFinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OptiFinePage_Loaded">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
                <ComboBox
                    x:Name="BaseCombo"
                    Width="320"
                    Header="基础版本（需为原版且已下载完整）"
                    HorizontalAlignment="Left"
                    SelectionChanged="BaseCombo_SelectionChanged" />

                <!-- OptiFine 区块 -->
                <StackPanel x:Name="OfSection" Spacing="12">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="OptiFine" />
                    <ComboBox
                        x:Name="OfCombo"
                        Width="320"
                        Header="OptiFine 版本"
                        HorizontalAlignment="Left"
                        PlaceholderText="正在获取版本列表…" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="QueueOfButton"
                            Click="QueueOf_Click"
                            Content="加入下载列表"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- LiteLoader 区块 -->
                <StackPanel x:Name="LlSection" Spacing="12">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="LiteLoader" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.75"
                        Text="仅支持 Minecraft 1.12.2 及更早版本，需要先选好对应基础版本。"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="LlCombo"
                        Width="320"
                        Header="LiteLoader 版本"
                        HorizontalAlignment="Left"
                        PlaceholderText="正在获取版本列表…" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="QueueLlButton"
                            Click="QueueLl_Click"
                            Content="加入下载列表"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    x:Name="StatusText"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 首次加载：列表拉取中 -->
        <ProgressRing
            x:Name="PageRing"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True" />
    </Grid>
</Page>
