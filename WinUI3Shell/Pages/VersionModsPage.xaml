<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.VersionModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20,20,20,12" RowDefinitions="Auto,*,Auto">
        <!-- 工具栏 -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Click="InstallMods_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="安装 Mod" />
                </StackPanel>
            </Button>
            <Button Click="OpenModsDir_Click" Content="打开 Mod 文件夹" />
            <Button
                AutomationProperties.Name="刷新列表"
                ToolTipService.ToolTip="刷新列表"
                Click="Refresh_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </StackPanel>

        <!-- Mod 列表 + 空状态提示 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ListView
                x:Name="ModList"
                ItemsSource="{x:Bind Mods}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,3" ColumnDefinitions="Auto,*,Auto">
                            <!-- 开关直接对应 启用/禁用，所见即所得 -->
                            <ToggleSwitch
                                VerticalAlignment="Center"
                                IsOn="{Binding IsEnabled, Mode=OneWay}"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                Tag="{Binding}"
                                Toggled="ModToggle_Toggled"
                                ToolTipService.ToolTip="启用 / 禁用" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SizeText}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="DeleteMod_Click"
                                Content="删除"
                                Foreground="#FF6363"
                                Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE7B8;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="还没有 Mod" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Text="点击上方「安装 Mod」导入 .jar 文件" />
            </StackPanel>
        </Grid>

        <!-- 底部：统计 + 状态 -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
