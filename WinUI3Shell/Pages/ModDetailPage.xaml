<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.ModDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!-- 标题 -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                Click="Back_Click"
                Padding="8"
                VerticalAlignment="Center">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <Border
                x:Name="IconBox"
                Width="56"
                Height="56"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="8"
                Visibility="Collapsed">
                <Image x:Name="IconImage" Stretch="UniformToFill" />
            </Border>
            <TextBlock
                x:Name="TitleText"
                MaxLines="2"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            x:Name="SubText"
            Grid.Row="1"
            Margin="0,6,0,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="DescriptionText"
            Grid.Row="2"
            Margin="0,8,0,0"
            MaxLines="3"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />

        <!-- 选择加载器与游戏版本 -->
        <StackPanel
            Grid.Row="3"
            Margin="0,16,0,0"
            Orientation="Horizontal"
            Spacing="8">
            <ComboBox
                x:Name="LoaderBox"
                Width="160"
                DisplayMemberPath="Display"
                SelectionChanged="LoaderBox_SelectionChanged" />
            <ComboBox
                x:Name="GameVersionBox"
                Width="160"
                SelectionChanged="GameVersionBox_SelectionChanged" />
        </StackPanel>

        <!-- 全部可下载包 -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <ListView x:Name="PackageList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{Binding DetailText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="Download_Click"
                                Content="下载"
                                Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE721;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="EmptyText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="没有可下载的包" />
            </StackPanel>
        </Grid>

        <!-- 进度 -->
        <StackPanel Grid.Row="5" Margin="0,8,0,0" Spacing="8">
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <ProgressBar
                x:Name="InstallBar"
                Maximum="1"
                Visibility="Collapsed" />
            <Button
                x:Name="CancelButton"
                HorizontalAlignment="Left"
                Click="Cancel_Click"
                Content="取消"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
