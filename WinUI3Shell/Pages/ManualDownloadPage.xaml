<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.ManualDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock
            x:Name="TitleText"
            Style="{StaticResource TitleTextBlockStyle}" />

        <!-- 工具行：Forge 需要先选游戏版本 -->
        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,12"
            Orientation="Horizontal"
            Spacing="8">
            <ComboBox
                x:Name="McVersionCombo"
                Width="150"
                PlaceholderText="游戏版本"
                Visibility="Collapsed"
                SelectionChanged="McVersionCombo_SelectionChanged" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView
                x:Name="BuildList"
                SelectionChanged="BuildList_SelectionChanged" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>

        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="QueueSelectedButton"
                Content="加入下载列表"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}"
                Click="QueueSelected_Click" />
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Page>
