<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowDefinitions="Auto,*,Auto">
        <!-- 标题 + 添加账号 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                Text="账号"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <Button
                x:Name="AddButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="添加账号">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="MicrosoftLogin_Click" Text="微软登录" />
                        <MenuFlyoutItem Click="OfflineLogin_Click" Text="离线账号" />
                        <MenuFlyoutItem Click="YggdrasilLogin_Click" Text="第三方登录" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 账号列表 + 空状态 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ListView
                x:Name="AccountList"
                IsItemClickEnabled="True"
                ItemClick="AccountList_ItemClick"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <!-- 皮肤头像 -->
                            <Grid Width="40" Height="40" VerticalAlignment="Center">
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" />
                                <FontIcon
                                    Glyph="&#xE77B;"
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding DetailText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="使用中"
                                Visibility="{Binding ActiveVisibility}" />
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Click="Delete_Click"
                                Content="删除"
                                Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE77B;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="还没有账号，右上角添加一个" />
            </StackPanel>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
