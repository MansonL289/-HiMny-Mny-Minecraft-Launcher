<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.VersionScreenshotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20,20,20,12" RowDefinitions="Auto,*,Auto">
        <!-- 工具栏 -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="OpenDir_Click" Content="打开截图文件夹" />
            <Button
                AutomationProperties.Name="刷新截图"
                ToolTipService.ToolTip="刷新"
                Click="Refresh_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </StackPanel>

        <!-- 截图网格 + 空状态提示 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <GridView
                x:Name="ShotGrid"
                ItemsSource="{x:Bind Shots}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Width="160"
                            Height="120"
                            Margin="0,0,8,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            DoubleTapped="Shot_DoubleTapped"
                            RightTapped="Shot_RightTapped"
                            Tag="{Binding}">
                            <Image
                                Width="160"
                                Height="120"
                                Source="{Binding Image}"
                                Stretch="UniformToFill" />
                            <Border
                                Height="34"
                                VerticalAlignment="Bottom"
                                Background="#A6000000">
                                <StackPanel Margin="6,2" Spacing="0">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="White"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#CCFFFFFF"
                                        Text="{Binding TimeText}" />
                                </StackPanel>
                            </Border>
                            <Button
                                Width="26"
                                Height="26"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#A6000000"
                                Click="DeleteShot_Click"
                                Tag="{Binding}"
                                ToolTipService.ToolTip="删除">
                                <FontIcon
                                    Glyph="&#xE74D;"
                                    FontSize="11"
                                    Foreground="White" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE722;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="还没有截图" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Text="在游戏里按 F2 截图后会出现在这里" />
            </StackPanel>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
