<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.SettingsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <!-- 入口：图标 + 标题 + 摘要 + 右箭头，点击进入子页面 -->
        <Button
            Padding="16,12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="OpenGame_Click">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE7FC;" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="游戏" FontWeight="SemiBold" />
                    <TextBlock
                        Text="分配内存、版本隔离、窗口大小、游戏语言"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    Glyph="&#xE76B;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>

        <Button
            Padding="16,12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="OpenDownload_Click">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE896;" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="下载" FontWeight="SemiBold" />
                    <TextBlock
                        Text="下载源"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    Glyph="&#xE76B;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>

        <Button
            Padding="16,12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="OpenLauncher_Click">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE713;" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="启动器" FontWeight="SemiBold" />
                    <TextBlock
                        Text="应用主题、开机自启动、游戏文件"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    Glyph="&#xE76B;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>
        <Button
            Padding="16,12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="OpenStorage_Click">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="储存" FontWeight="SemiBold" />
                    <TextBlock
                        Text="清除缓存、批量删除版本"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    Glyph="&#xE76B;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>
        <Button
            Padding="16,12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="OpenAbout_Click">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE946;" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="关于" FontWeight="SemiBold" />
                    <TextBlock
                        Text="版本信息、反馈与更新"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    Glyph="&#xE76B;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>
    </StackPanel>
</Page>
