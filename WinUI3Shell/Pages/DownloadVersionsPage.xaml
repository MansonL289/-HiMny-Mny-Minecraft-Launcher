<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.DownloadVersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部：版本分类 + 刷新（下载源在 设置→下载 中调整） -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox
                x:Name="CategoryBox"
                Width="130"
                Height="32"
                SelectedIndex="0"
                SelectionChanged="CategoryBox_SelectionChanged">
                <ComboBoxItem Content="原版游戏" Tag="0" />
                <ComboBoxItem Content="快照版" Tag="1" />
                <ComboBoxItem Content="远古版" Tag="2" />
                <ComboBoxItem Content="愚人节版" Tag="3" />
            </ComboBox>
            <Button
                x:Name="RefreshButton"
                Height="32"
                AutomationProperties.Name="刷新版本列表"
                ToolTipService.ToolTip="刷新版本列表"
                Click="Refresh_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <ListView
                x:Name="VersionList"
                IsItemClickEnabled="True"
                ItemClick="VersionList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,6">
                            <Grid Width="36" Height="36" VerticalAlignment="Center">
                                <Image
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding IconUrl}"
                                    Stretch="Uniform" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding Id}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>

        <TextBlock
            x:Name="DlStatus"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</Page>
