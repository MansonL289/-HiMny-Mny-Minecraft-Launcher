<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.DownloadVersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部：版本分类 + 刷新（下载源在 设置→下载 中调整） -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox
                x:Name="CategoryBox"
                Width="130"
                Height="32"
                SelectedIndex="0"
                SelectionChanged="CategoryBox_SelectionChanged">
                <ComboBoxItem Content="原版游戏" Tag="0" />
                <ComboBoxItem Content="快照版" Tag="1" />
                <ComboBoxItem Content="远古版" Tag="2" />
                <ComboBoxItem Content="愚人节版" Tag="3" />
            </ComboBox>
            <Button
                x:Name="RefreshButton"
                Height="32"
                AutomationProperties.Name="刷新版本列表"
                ToolTipService.ToolTip="刷新版本列表"
                Click="Refresh_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </StackPanel>

        <ListView
            x:Name="VersionList"
            Grid.Row="1"
            Margin="0,10,0,10"
            IsItemClickEnabled="True"
            ItemClick="VersionList_ItemClick" />

        <TextBlock
            x:Name="DlStatus"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</Page>
