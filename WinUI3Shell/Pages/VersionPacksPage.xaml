<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.VersionPacksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20,20,20,12" RowDefinitions="Auto,*,Auto,*" RowSpacing="6">
        <!-- 资源包 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="资源包" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="ImportResource_Click" Content="导入" />
                <Button Click="OpenResourceDir_Click" Content="打开文件夹" />
            </StackPanel>
        </Grid>

        <ListView
            x:Name="ResourceList"
            Grid.Row="1"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,4" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{Binding SubtitleText}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            Margin="0,0,8,0"
                            IsOn="{Binding Enabled}"
                            Tag="{Binding}"
                            Toggled="PackToggle_Toggled"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="2"
                            Click="DeletePack_Click"
                            Content="删除"
                            Tag="{Binding}"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 光影 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="光影" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="ImportShader_Click" Content="导入" />
                <Button Click="OpenShaderDir_Click" Content="打开文件夹" />
            </StackPanel>
        </Grid>

        <ListView
            x:Name="ShaderList"
            Grid.Row="3"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,4" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{Binding SubtitleText}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            Margin="0,0,8,0"
                            IsOn="{Binding Enabled}"
                            Tag="{Binding}"
                            Toggled="PackToggle_Toggled"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="2"
                            Click="DeletePack_Click"
                            Content="删除"
                            Tag="{Binding}"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
