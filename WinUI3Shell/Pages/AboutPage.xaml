<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="AboutPage_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="20" MaxWidth="620" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="MnyMinecraftLauncher Beta" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="版本号 Beta_1.4.20261101" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="硬件信息" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="CpuText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="GpuText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="MemoryText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="反馈与意见" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <HyperlinkButton
                    Padding="0"
                    Content="https://github.com/MansonL289/HiMny-MnyMinecraftLauncher/issues"
                    NavigateUri="https://github.com/MansonL289/HiMny-MnyMinecraftLauncher/issues" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="更新最新版" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <HyperlinkButton
                    Padding="0"
                    Content="https://github.com/MansonL289/HiMny-MnyMinecraftLauncher/tags"
                    NavigateUri="https://github.com/MansonL289/HiMny-MnyMinecraftLauncher/tags" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" Content="检查更新" />
                    <ProgressRing
                        x:Name="CheckRing"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="UpdateText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
