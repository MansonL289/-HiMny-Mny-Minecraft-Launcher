<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="DownloadsPage_Loaded">

    <Grid Padding="24,12,24,16" ColumnDefinitions="160,*">
        <!-- 左侧栏（WinUI3 NavigationView 风格）：游戏版本 / 手动下载各加载器 / 下载任务 -->
        <NavigationView
            x:Name="SideBar"
            Margin="0,0,16,0"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="160"
            PaneDisplayMode="Left"
            SelectionChanged="SideBar_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="游戏版本" Tag="versions" IsSelected="True" />
                <NavigationViewItem Content="Forge" Tag="forge" />
                <NavigationViewItem Content="Fabric" Tag="fabric" />
                <NavigationViewItem Content="NeoForge" Tag="neoforge" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="下载任务" Tag="tasks">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
        </NavigationView>

        <!-- 右侧内容区：子页面 -->
        <Frame x:Name="DlFrame" Grid.Column="1" />
    </Grid>
</Page>
