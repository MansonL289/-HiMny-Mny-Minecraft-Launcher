<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.GameSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="32">

            <StackPanel Spacing="8">
                <TextBlock Text="分配内存" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons
                    x:Name="MemoryModeRadio"
                    SelectionChanged="MemoryModeRadio_SelectionChanged">
                    <RadioButton Content="自动（可用内存的 2/3）" />
                    <RadioButton Content="自定义" />
                </RadioButtons>
                <NumberBox
                    x:Name="MemoryBox"
                    Width="200"
                    HorizontalAlignment="Left"
                    Minimum="512"
                    LargeChange="1024"
                    SmallChange="256"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="MemoryBox_ValueChanged" />
                <!-- 内存占用条：深蓝=系统占用，浅蓝=游戏分配，白色=空闲，实时刷新 -->
                <Border
                    Width="320"
                    HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="1">
                    <Grid Height="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MemoryUsedCol" Width="*" />
                            <ColumnDefinition x:Name="MemoryGameCol" Width="*" />
                            <ColumnDefinition x:Name="MemoryFreeCol" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0F6CBD" />
                        <Border Grid.Column="1" Background="#9BCBF7" />
                        <Border Grid.Column="2" Background="White" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Background="#0F6CBD"
                            CornerRadius="2" />
                        <TextBlock
                            Text="系统占用"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Background="#9BCBF7"
                            CornerRadius="2" />
                        <TextBlock
                            Text="游戏分配"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="2" />
                        <TextBlock
                            Text="空闲"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    x:Name="MemoryInfoText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="游戏窗口大小" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="WindowSizeBox"
                    Width="200"
                    HorizontalAlignment="Left"
                    SelectionChanged="WindowSizeBox_SelectionChanged">
                    <ComboBoxItem Content="854 × 480" Tag="854,480" />
                    <ComboBoxItem Content="1280 × 720" Tag="1280,720" />
                    <ComboBoxItem Content="1600 × 900" Tag="1600,900" />
                    <ComboBoxItem Content="1920 × 1080" Tag="1920,1080" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="游戏语言" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="LanguageBox"
                    Width="320"
                    HorizontalAlignment="Left"
                    MaxDropDownHeight="400"
                    SelectionChanged="LanguageBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="版本隔离" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="IsolationBox"
                    Width="360"
                    HorizontalAlignment="Left"
                    SelectionChanged="IsolationBox_SelectionChanged">
                    <ComboBoxItem Content="关闭" Tag="off" />
                    <ComboBoxItem Content="隔离可安装 Mod 的版本" Tag="modded" />
                    <ComboBoxItem Content="隔离非正式版" Tag="unofficial" />
                    <ComboBoxItem Content="隔离可安装 Mod 的版本与非正式版" Tag="modded_unofficial" />
                    <ComboBoxItem Content="隔离所有版本" Tag="all" />
                </ComboBox>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
