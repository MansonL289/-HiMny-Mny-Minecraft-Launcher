<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.DownloadTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:WinUI3Shell.Pages"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <pages:InverseBoolToVisibilityConverter x:Key="InvVis" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 标题栏 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="下载任务" />
            <Button
                x:Name="ClearButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="ClearFinished_Click"
                Content="清除已完成" />
        </Grid>

        <!-- 任务列表 + 空状态 -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <ListView
                x:Name="JobList"
                ItemsSource="{x:Bind Rows}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{Binding StatusBrush}"
                                    Text="{Binding StatusText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="CancelJob_Click"
                                Content="取消"
                                Tag="{Binding}"
                                Visibility="{Binding Done, Converter={StaticResource InvVis}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE896;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Text="暂无下载任务" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Text="在「游戏版本」或「MOD」里开始下载" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
